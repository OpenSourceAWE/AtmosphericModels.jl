#!/bin/bash -eu
# SPDX-FileCopyrightText: 2025 Uwe Fechner
# SPDX-License-Identifier: MIT

if [[ $(basename "$(pwd)") == "bin" ]]; then
    cd ..
fi

usage() {
    cat <<'EOF'
Usage: bin/install [-y] [--update] [-h]

Installs the environment this repo pins: copies the tracked default manifest
over the live one, instantiates and precompiles it and the workspace projects.

  -y        no terminal: skip the version menu and use the installed Julia
  --update  update the live manifest instead of installing the tracked one;
            the .default manifests are left untouched
  -h        show this help
EOF
}

assume_yes=false
update_manifest=false
while [[ $# -gt 0 ]]; do
    case "$1" in
        -y)        assume_yes=true ;;
        --update)  update_manifest=true ;;
        -h|--help) usage; exit 0 ;;
        *)         echo "Error: unknown option '$1'." >&2; usage >&2; exit 1 ;;
    esac
    shift
done

if ! command -v julia &> /dev/null; then
    echo "Error: julia is not installed. Install it with juliaup:" >&2
    case "$(uname -s)" in
        Linux|Darwin)
            echo "  curl -fsSL https://install.julialang.org | sh" >&2
            ;;
        MINGW*|MSYS*|CYGWIN*)
            echo "  winget install --name Julia --id 9NJNWW8PVKMN -e -s msstore" >&2
            ;;
        *)
            echo "  See https://github.com/JuliaLang/juliaup" >&2
            ;;
    esac
    exit 1
fi

required_kb=$((5 * 1024 * 1024))
available_kb=$(df -k "$HOME" | awk 'NR==2 {print $4}')
if [[ -z $available_kb ]]; then
    echo "Error: could not determine the free disk space in $HOME." >&2
    exit 1
fi
if (( available_kb < required_kb )); then
    echo "Error: $HOME has less than 5 GB free." >&2
    exit 1
fi

# JULIAUP_CHANNEL selects the channel for this script alone; the juliaup default stays put.
if [[ $assume_yes == false ]]; then
    if ! command -v juliaup &> /dev/null; then
        echo "Error: juliaup is not installed; rerun with -y to use the julia on PATH." >&2
        exit 1
    fi
    echo "Which Julia version do you want to use?"
    echo "  1) Julia 1.11"
    echo "  2) Julia 1.12"
    echo "  3) Julia 1.13"
    read -rp "Enter 1, 2 or 3 [default: 3]: " julia_choice
    case "${julia_choice}" in
        1)     channel="1.11" ;;
        2)     channel="1.12" ;;
        3|"")  channel="1.13" ;;
        *)     echo "Error: invalid choice '${julia_choice}'." >&2; exit 1 ;;
    esac
    juliaup add "${channel}"
    export JULIAUP_CHANNEL="${channel}"
fi

julia_version=$(julia --version | awk '{print $3}')
julia_minor=${julia_version%.*}
echo "Using Julia ${julia_version}."

default_manifest="Manifest-v${julia_minor}.toml.default"
if [[ ! -f $default_manifest ]]; then
    echo "Error: no $default_manifest; this repo does not support Julia $julia_minor." >&2
    exit 1
fi

export JULIA_PKG_SERVER_REGISTRY_PREFERENCE=eager

if [[ $update_manifest == true ]]; then
    echo "Updating Manifest-v${julia_minor}.toml..."
    julia --project -e 'using Pkg; Pkg.update()'
else
    cp "$default_manifest" "Manifest-v${julia_minor}.toml"
    echo "Copied $default_manifest to Manifest-v${julia_minor}.toml"
    julia --project -e 'using Pkg; Pkg.instantiate()'
fi

# The workspace projects share the root manifest but precompile separately.
for project in . examples test docs; do
    echo "Precompiling ${project}..."
    julia --project="${project}" -e 'using Pkg; Pkg.precompile()'
done

printf "\n\033[1;32mInstallation complete!\033[0m\n\n"
echo "Launch Julia on this repo with:"
echo "  ./bin/run_julia"
